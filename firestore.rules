rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read/write only their own document
    // The codebase uses the email address as the document ID
    match /users/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // SHARED RECEIPTS (Universal Sharing)
    // Allow any authenticated user to read/write shared receipts
    // This allows User A (main) to write status for User B (secondary) 
    // provided they know the source email.
    match /shared_receipts/{sourceEmail}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // FEEDBACK: Allow anyone to submit feedback
    match /feedback/{document=**} {
      allow create: if true;
      allow read, update, delete: if false; // Only allow creation
    }
  }
}
